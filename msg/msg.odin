// SOURCES is each shipped locale's text. A locale without one is not offered.
@(rodata)
SOURCES := [i18n.Locale]string {
	.English             = #load("locales/en.txt", string),
	.Spanish             = #load("locales/es.txt", string),
	.French              = #load("locales/fr.txt", string),
	.German              = #load("locales/de.txt", string),
	.Italian             = #load("locales/it.txt", string),
	.Portuguese_Brazil   = #load("locales/pt-BR.txt", string),
	.Dutch               = #load("locales/nl.txt", string),
	.Polish              = #load("locales/pl.txt", string),
	.Russian             = #load("locales/ru.txt", string),
	.Ukrainian           = #load("locales/uk.txt", string),
	.Turkish             = #load("locales/tr.txt", string),
	.Arabic              = #load("locales/ar.txt", string),
	.Hindi               = #load("locales/hi.txt", string),
	.Bengali             = #load("locales/bn.txt", string),
	.Thai                = #load("locales/th.txt", string),
	.Vietnamese          = #load("locales/vi.txt", string),
	.Indonesian          = #load("locales/id.txt", string),
	.Japanese            = #load("locales/ja.txt", string),
	.Korean              = #load("locales/ko.txt", string),
	.Chinese_Simplified  = #load("locales/zh-Hans.txt", string),
	.Chinese_Traditional = #load("locales/zh-Hant.txt", string),
}


// Strings is the text in use: English, loaded once as the base, and the
// locale in use, whose gaps load fills from it. Nothing is allocated.
Strings :: struct {
	base:   i18n.Table(Msg),
	active: i18n.Table(Msg),
}

// init loads English and then locale.
init :: proc(s: ^Strings, locale: i18n.Locale) {
	i18n.load(&s.base, .English, SOURCES[.English])
	use(s, locale)
}

// use puts locale in use. One we do not ship falls back to English.
use :: proc(s: ^Strings, locale: i18n.Locale) {
	chosen := shipped(locale) ? locale : .English
	i18n.load(&s.active, chosen, SOURCES[chosen], &s.base)
}

// shipped is whether locale's text is in the binary.
shipped :: proc(locale: i18n.Locale) -> bool {
	return SOURCES[locale] != ""
}

// locale is the locale s is showing.
locale :: proc(s: ^Strings) -> i18n.Locale {
	return i18n.table_locale(&s.active)
}

// tr is key's text, with no arguments.
tr :: proc(s: ^Strings, key: Msg) -> string {
	return i18n.text(&s.active, key)
}

// trb writes key's text with args filled in to buf.
trb :: proc(s: ^Strings, buf: []u8, key: Msg, args: ..i18n.Arg) -> (text: string, ok: bool) {
	return i18n.bformat(buf, &s.active, key, ..args)
}

// trf is key's text with args filled in, allocated by allocator.
trf :: proc(s: ^Strings, key: Msg, args: ..i18n.Arg, allocator := context.temp_allocator) -> string {
	return i18n.format(&s.active, key, ..args, allocator = allocator)
}

// form is key's plural form for count, in the locale s is showing.
form :: proc(s: ^Strings, key: Msg, count: int) -> string {
	return i18n.form(&s.active, key, i18n.plural(locale(s), count))
}

// The process-wide table. The desk's host and the CLI share one per
// process; the view keeps its own Strings on the model and saves the tag
// the host reads back. Tests that never boot stay on English, and never
// read a person's saved tag.
@(private)
g: struct {
	once:    sync.Once,
	booted:  bool,
	conf:    string,
	strings: Strings,
}

@(private)
pending_locale: i18n.Locale
@(private)
pending_conf: string

@(private)
do_init :: proc() {
	init(&g.strings, pending_locale)
	g.conf = pending_conf
}

// boot loads the startup locale once. A later boot switches the table
// when the choice changed.
boot :: proc(conf: string, system: []string) {
	pending_conf = conf
	pending_locale = startup_locale(conf, system)
	sync.once_do(&g.once, do_init)
	g.booted = true
	g.conf = pending_conf
	if locale(&g.strings) != pending_locale {
		use(&g.strings, pending_locale)
	}
}

// refresh re-reads the saved tag. A desk that has not booted, or a test,
// keeps the table it has.
refresh :: proc() {
	if !g.booted || g.conf == "" {
		return
	}
	tag, found := read_tag(g.conf, context.temp_allocator)
	if !found {
		return
	}
	chosen, ok := i18n.locale_match(tag)
	if ok && shipped(chosen) && chosen != locale(&g.strings) {
		use(&g.strings, chosen)
	}
}

// use_global switches the process-wide table, after boot has had its say.
use_global :: proc(chosen: i18n.Locale) {
	sync.once_do(&g.once, do_init)
	use(&g.strings, chosen)
}

// locale_now is the process-wide locale.
locale_now :: proc() -> i18n.Locale {
	sync.once_do(&g.once, do_init)
	return locale(&g.strings)
}

// text is key in the process-wide locale.
text :: proc(key: Msg) -> string {
	sync.once_do(&g.once, do_init)
	return tr(&g.strings, key)
}

// textf is text with arguments filled in.
textf :: proc(key: Msg, args: ..i18n.Arg, allocator := context.temp_allocator) -> string {
	sync.once_do(&g.once, do_init)
	return trf(&g.strings, key, ..args, allocator = allocator)
}

// text_form is key's plural form for count in the process-wide locale.
text_form :: proc(key: Msg, count: int) -> string {
	sync.once_do(&g.once, do_init)
	return form(&g.strings, key, count)
}
